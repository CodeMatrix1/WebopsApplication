<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>login</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <div class="container">
        <h2>Signup</h2>
        <form action="/signup" method="post">
        <div class="input-element">
            <label for="name">Username:</label>
        <input name="name" type="text" class ='input' id="username" placeholder="enter username" required/>
        </div>
        <div class="input-element">
            <label for="password">Password:</label>
        <input name="password" type="password" class ='password' id="password" placeholder ="enter password" required/>
    </div>
    <button type="submit" class="button">Signup</button>
    </form>
    </div>
    
</body>
</html>
